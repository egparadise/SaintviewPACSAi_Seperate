# Saintview Viewer Suite — 백엔드 설정 예시
# 최초 실행 전 이 파일을 .env 로 복사(런처가 자동 복사)하고 필요 값을 조정하세요.
# 시크릿(API 키·운영 비밀번호)은 절대 커밋 금지.

# ── 스위트 자체 스택 기본값 (deploy/docker-compose.yml 과 짝) ──
# ⚠ 반드시 127.0.0.1 — 'localhost' 는 IPv6(::1) 우선 조회 후 IPv4 폴백으로 연결당 ~200ms 지연
SAINTVIEW_DATABASE_URL=postgresql+psycopg2://saintview:saintview_dev@127.0.0.1:5434/saintview
SAINTVIEW_ORTHANC_URL=http://127.0.0.1:8043
SAINTVIEW_OHIF_URL=http://127.0.0.1:3001
SAINTVIEW_API_URL=http://127.0.0.1:8010
SAINTVIEW_PG_PORT=5434
# 메인 Saintview(11112)와 충돌하지 않는 MPPS 포트
SAINTVIEW_MPPS_PORT=11113
SAINTVIEW_MPPS_AET=SVVIEWER

# ── 외부 서버 연동 시 위 URL 들을 대상 서버로 교체 ──
# SAINTVIEW_DATABASE_URL=postgresql+psycopg2://user:pw@<서버IP>:5433/saintview
# SAINTVIEW_ORTHANC_URL=http://<서버IP>:8042
# SAINTVIEW_CORS_ORIGINS=https://viewer.example.com,https://his.example.com

# ── AI — 뷰어 스위트 기본은 mock(실 API 호출 없음). 판독 초안 생성은 보류(ai.policy.draft_enabled) ──
SAINTVIEW_AI_MODE=mock
# ANTHROPIC_API_KEY=

# ── 운영 배포 시(SAINTVIEW_ENV=prod 게이트) ──
# SAINTVIEW_ENV=prod
# SAINTVIEW_JWT_SECRET=<32자 이상 무작위>
# SAINTVIEW_ADMIN_PASSWORD=<기본값 금지>
# SAINTVIEW_ORTHANC_PASSWORD=<기본값 금지>
