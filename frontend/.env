# Saintview Viewer Suite — 프론트 설정 (뷰어 전용 부팅)
# 5180 포트를 Client 포털 역할로 매핑 → 로그인 → Worklist → I-View/T-View/SaintView 부팅
VITE_PORT_CLIENT=5180
# 병원·계정 관리가 필요할 때: 5181 로 두 번째 인스턴스를 띄우면 관리자 포털로 부팅(README 참조)
VITE_PORT_ADMIN=5181

# API 베이스 — 빈값 = 같은 출처 상대경로(/api) → vite 프록시 경유(원격 접속에서도 동작).
# 외부의 기존 Saintview 서버에 프론트만 붙일 때는 http://<서버IP>:8000 형태로 지정.
VITE_API_BASE=
VITE_DICOMWEB_ROOT=/dicom-web

# OHIF(Advance View) 베이스 — 스위트 내장 OHIF
VITE_OHIF_BASE=http://localhost:3001
